<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.classroom.sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/PATH/TO/YOUR/PROJECT/.venv/bin/python</string>
        <string>/PATH/TO/YOUR/PROJECT/main.py</string>
        <string>sync</string>
        <string>--max-age-days</string>
        <string>30</string>
    </array>
    <key>StartInterval</key>
    <!-- Run interval in seconds: 345600 = 4 days -->
    <integer>345600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/PATH/TO/YOUR/PROJECT/sync.log</string>
    <key>StandardErrorPath</key>
    <string>/PATH/TO/YOUR/PROJECT/sync_error.log</string>
</dict>
</plist>

