# =================================================================
# Google Classroom to Calendar & AI Sync - Environment Variables
# =================================================================

# (Optional) Gemini API Key for auto-solving PDF assignments with AI
# Get a free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Recipient email address for receiving solved assignment PDF reports
RECIPIENT_EMAIL=your_email@example.com

# (Optional) Fallback timezone for deadlines (e.g., "Asia/Kolkata", "America/New_York", "UTC", "auto")
SYNC_TIMEZONE=auto
